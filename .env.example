# FireRaid environment — DO NOT COMMIT REAL VALUES

# Defense secrets (generate: openssl rand -hex 32)
FIRERAID_PROFILE_SECRET=replace-with-64-char-hex
FIRERAID_CSRF_SECRET=replace-with-64-char-hex

# Turnstile — test credentials for local dev
# Always-pass: 1x00000000000000000000AA
# Always-fail: 2x00000000000000000000AB
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA

# Admin
ADMIN_SECRET=replace-with-strong-random-value

# Profile & mode
PROFILE_VERSION=1
LAB_MODE=true

# LLM harness (production defense MUST NOT use these)
FIRERAID_LLM_BASE_URL=
FIRERAID_LLM_API_KEY=
FIRERAID_LLM_MODEL=
