{
  "name": "fireraid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, server-led admission defense middleware for automated signup/application abuse.",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "build": "tsc -p tsconfig.dist.json",
    "build:product": "tsc -p tsconfig.product.json --noEmit",
    "check:boundary": "node scripts/check-product-boundary.mjs",
    "check:production-graph": "node scripts/check-production-graph.mjs",
    "test:product": "npm run build:product && npm run check:boundary",
    "test:package": "node scripts/release-package-smoke.mjs",
    "dev:origin": "tsx examples/origin-server.mjs",
    "demo": "tsx demo/server.ts",
    "typecheck:demo": "tsc -p tsconfig.demo.json --noEmit",
    "test:demo": "DEMO_SMOKE=1 vitest run tests/demo",
    "test:origin-budget": "node --import tsx scripts/origin-budget.mjs",
    "test:integration": "node scripts/test-worker.mjs --suite test-integration --port 8799 -- vitest run --config vitest.integration.config.ts",
    "test:llm-smoke": "node scripts/test-worker.mjs --suite test-integration --port 8799 -- vitest run --config vitest.llm-smoke.config.ts",
    "test:envelope": "node scripts/test-worker.mjs --suite test-envelope --port 8799 --wrangler-env production-test -- vitest run --config vitest.envelope.config.ts",
    "test:budget": "node --import tsx scripts/budget-harness.mjs",
    "test:worker-isolation": "node scripts/test-worker-isolation.spec.mjs",
    "test:ledger-proof": "node --import tsx scripts/ledger-proof.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright install chromium firefox webkit && playwright test --config=playwright.production.config.ts",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"harness/**/*.ts\" \"tests/**/*.ts\" \"demo/**/*.ts\" \"scripts/**/*.mjs\" --max-warnings 0",
    "test:e2e:ci": "playwright install chromium firefox webkit && playwright test",
    "deploy": "npm run deploy:production",
    "deploy:lab": "wrangler deploy --env public-lab",
    "predeploy:production": "node scripts/predeploy-production.mjs --local",
    "predeploy:production:deploy": "node scripts/predeploy-production.mjs --deploy",
    "deploy:production": "npm run predeploy:production:deploy && node scripts/deploy-production.mjs",
    "predeploy:demo": "node scripts/predeploy-production.mjs --demo",
    "deploy:demo": "npm run predeploy:demo && node scripts/deploy-production.mjs --demo",
    "experiment": "tsx harness/core/runner.ts",
    "analyze": "python3 harness/analysis/analyze.py",
    "release:verify:fast": "node scripts/release-verify.mjs fast",
    "release:verify:full": "node scripts/release-verify.mjs full",
    "release:verify": "node scripts/release-verify.mjs full --require-tier release_ready",
    "release:smoke:record": "node scripts/release-smoke-record.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "license": "LicenseRef-FireRaid-Community-Source-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-A-M-N/FireRaid.git"
  },
  "bugs": {
    "url": "https://github.com/B-A-M-N/FireRaid/issues"
  },
  "homepage": "https://github.com/B-A-M-N/FireRaid#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/host-adapter/index.d.ts",
      "import": "./dist/host-adapter/index.js"
    },
    "./node": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./adapters": {
      "types": "./dist/host-adapter/index.d.ts",
      "import": "./dist/host-adapter/index.js"
    },
    "./evaluation": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.js"
    }
  }
}
