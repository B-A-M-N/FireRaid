# FireRaid DEFENSE-PLANE environment — DO NOT COMMIT REAL VALUES
# Harness/LLM credentials live separately in harness/.env.example.
# The defense plane must never see harness secrets, and vice versa.

# Defense secrets (generate: openssl rand -hex 32)
FIRERAID_PROFILE_SECRET=replace-with-64-char-hex
FIRERAID_CSRF_SECRET=replace-with-64-char-hex

# Profile key ring (FR-R6-043) — current key id + optional previous secrets.
# FIRERAID_PROFILE_KEY_PREVIOUS is JSON: {"<old-key-id>":"<old-secret>",...}
FIRERAID_PROFILE_KEY_CURRENT_ID=k1
FIRERAID_PROFILE_KEY_PREVIOUS=

# Lab correlation API auth — required for lab-run create/get (FR-R4-030)
FIRERAID_LAB_API_SECRET=

# Turnstile — test credentials for local dev
# Always-pass: 1x00000000000000000000AA
# Always-fail: 2x00000000000000000000AB
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA
# Hostname enforcement on Siteverify (production should set this)
TURNSTILE_EXPECTED_HOSTNAME=

# Admin
ADMIN_SECRET=replace-with-strong-random-value

# Profile & mode
PROFILE_VERSION=1
LAB_MODE=false
