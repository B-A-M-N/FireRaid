# FireRaid ATTACK-PLANE (harness) environment — DO NOT COMMIT REAL VALUES
# These credentials drive the agent adapters ONLY. Never reference them from
# src/ (the defense plane), and never put defense secrets in this file.

# LLM backend for raw-dom / ax-snapshot adapters
FIRERAID_LLM_BASE_URL=
FIRERAID_LLM_API_KEY=

# Authenticated lab mode: lets the runner create lab runs + post outcomes
FIRERAID_LAB_API_SECRET=

# Set to any value to let the runner proceed with a dirty git tree (dev only)
FIRERAID_ALLOW_DIRTY=
