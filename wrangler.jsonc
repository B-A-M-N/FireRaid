{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fireraid",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/signup",
      "/api/*",
      "/c/*",
      "/admin*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fireraid",
      "database_id": "REPLACE_AFTER_CREATE"
    }
  ],

  // FR-R4-076 / FR-R6-085: top-level is SAFE by default — a bare
  // `wrangler deploy` must never publish lab semantics. Named environments
  // (dev/test) opt into LAB_MODE explicitly. Named-env deploys are the only
  // supported deploy path (npm run deploy:lab / deploy:production).
  "vars": {
    "PROFILE_VERSION": "1",
    "LAB_MODE": "false"
  },

  "env": {
    // FR-R6-001: named environments do NOT inherit top-level bindings —
    // d1_databases and assets are restated in EVERY env block.
    "dev": {
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
          "/signup",
          "/api/*",
          "/c/*",
          "/admin*"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fireraid",
          "database_id": "REPLACE_AFTER_CREATE"
        }
      ],
      "vars": {
        "PROFILE_VERSION": "1",
        "LAB_MODE": "true"
      }
    },
    // FR-R5-039: test bootstrap (-e test) — loads .dev.vars.test, which has
    // NO Turnstile credentials, so the submit path skips Turnstile entirely.
    // NOTE: named environments do NOT inherit top-level bindings — d1/assets
    // must be restated here (same binding names).
    "test": {
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
          "/signup",
          "/api/*",
          "/c/*",
          "/admin*"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fireraid",
          "database_id": "REPLACE_AFTER_CREATE"
        }
      ],
      "vars": {
        "PROFILE_VERSION": "1",
        "LAB_MODE": "true"
      }
    },
    "public-lab": {
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
          "/signup",
          "/api/*",
          "/c/*",
          "/admin*"
        ]
      },
      // FR-R6-001: public-lab MUST get its own D1 database before real deploy
      // (swap database_id; `wrangler d1 create fireraid-public-lab`).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fireraid-public-lab",
          "database_id": "REPLACE_AFTER_CREATE"
        }
      ],
      "vars": {
        "PROFILE_VERSION": "1",
        "LAB_MODE": "true"
      }
    },
    "production": {
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
          "/signup",
          "/api/*",
          "/c/*",
          "/admin*"
        ]
      },
      // FR-R6-001: production MUST have a distinct database from public-lab —
      // swap database_id (`wrangler d1 create fireraid-production`).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fireraid-production",
          "database_id": "REPLACE_AFTER_CREATE"
        }
      ],
      "vars": {
        "PROFILE_VERSION": "1",
        "LAB_MODE": "false"
      }
    }
  },

  "observability": {
    "enabled": true
  }
}
